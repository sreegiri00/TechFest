# SMTP Email Configuration
# Examples:
# For Gmail:
# SMTP_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# MAIL_FROM="TechFest Hub" <your-email@gmail.com>
#
# Or custom SMTP host:
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# MAIL_FROM="TechFest Hub" <noreply@yourdomain.com>
